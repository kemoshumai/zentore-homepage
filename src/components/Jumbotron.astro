---
import { Image } from 'astro:assets';
import logo from '../images/logo.png';
---

<div class="w-full bg-sky-200 flex flex-col justify-center" style="height:90svh;" >
    <div class="bg-transparent flex justify-center max-h-64">
        <div class="flex flex-col h-full bg-transparent items-center">
            <Image class="bg-transparent h-full w-auto object-scale-down" src={logo} alt="全トレ" />
            <p class="text-center bg-transparent">"全部トレーニングですべてを鍛えよう。"</p>
            <a href="https://store.steampowered.com/app/3599160/_/" class="block w-48 text-center bg-orange-600 rounded text-2xl mt-4 text-white py-2">"配布ページへ"</a>
        </div>
    </div>
</div>
