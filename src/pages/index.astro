---
import Jumbotron from '../components/Jumbotron.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="bg-sky-700">
		<Jumbotron />
		<div class="bg-sky-500 p-4">
			<div class="bg-transparent max-w-screen-md w-full block mx-auto">
				<h2 class="bg-transparent text-5xl text-white font-extrabold" style="transform: rotate(-12deg) translateY(-48px); -webkit-text-stroke: 1px black; text-stroke: 1px black; ">"運動しながら"<br />"問題も解こう！！"</h2>

				<div class="my-12 bg-transparent">
					<img src="./public/screenshot_story.png" class="bg-transparent w-full h-full max-w-24 object-contain" />
					<p class="bg-transparent text-2xl text-white max-w-24">"大学に落ちてしまった上、失恋までした主人公。ある日、マッチョなインテリと出会い、脳力も恋愛も鍛えるため、全トレの修行に挑む！！"</p>
				</div>

				<div class="my-12 bg-transparent">
					<img src="./public/screenshot_game.png" class="bg-transparent w-full h-full max-w-24 object-contain" />
					<p class="bg-transparent text-2xl text-white max-w-24">"画面の前で運動をして、問題を隠しているブロックを消せ！！"<br />"問題は分かった時点で解答できるぞ！"</p>
				</div>

				<div class="my-12 bg-transparent">
					<img src="./public/screenshot_result.png" class="bg-transparent w-full h-full max-w-24 object-contain" />
					<p class="bg-transparent text-2xl text-white max-w-24">"君は全トレを極めて、無事A判定を取ることができるか！？"</p>
				</div>
			</div>
		</div>
	</div>
</Layout>
